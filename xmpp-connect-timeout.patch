Without it the irssi core connect timeout (connect_time == 0) aborts XMPP
logins, e.g. STARTTLS + password prompt: https://github.com/cdidier/irssi-xmpp/issues/43

From 57c62278b97aeb999f3ca2e2b8a492f364405b61 Mon Sep 17 00:00:00 2001
From: Ailin Nemui <ailin@z30a.localdomain>
Date: Tue, 29 Jan 2019 21:37:05 +0100
Subject: [PATCH] do not trigger the irssi core connect timeout prematurely

---
 src/core/xmpp-servers.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/core/xmpp-servers.c b/src/core/xmpp-servers.c
index 8d0b62d..bbd09cb 100644
--- a/src/core/xmpp-servers.c
+++ b/src/core/xmpp-servers.c
@@ -489,6 +489,7 @@ xmpp_server_connect(XMPP_SERVER_REC *server)
 	}
 	lm_connection_set_disconnect_function(server->lmconn,
 	    lm_close_cb, server, NULL);
+	server->connect_time = time(NULL);
 	lookup_servers = g_slist_append(lookup_servers, server);
 	signal_emit("server looking", 1, server);
 	server->timeout_tag = g_timeout_add(
